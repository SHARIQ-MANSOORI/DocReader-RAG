# Google Gemini API Key (get from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Firebase Configuration (for auth.js)
FIREBASE_PROJECT_ID=your_firebase_project_id
# Optional: path to service account key file or JSON string
FIREBASE_SERVICE_ACCOUNT=
# Optional: required if using server-side email/password login endpoint
FIREBASE_API_KEY=
